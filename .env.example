# Groq API key — compte gratuit sur https://console.groq.com
GROQ_API_KEY=gsk_...

# Secret JWT (n'importe quelle chaîne aléatoire, min 32 caractères)
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# Chemin vers la base SQLite (fichier local, créé automatiquement)
DATABASE_URL=./meeting_recorder.db

# Port du serveur
PORT=3000
NODE_ENV=development

# Titre affiché dans l'interface
VITE_APP_TITLE=Meeting Recorder
